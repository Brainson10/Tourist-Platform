DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tourism_platform?schema=public"

# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Optional, comma-separated
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Optional: override the OpenStreetMap Overpass endpoint used for nearby places
# OVERPASS_API_URL="https://overpass-api.de/api/interpreter"

# Photo uploads (production). Without these, development stores uploads in public/uploads.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Optional: map tiles (defaults to OpenStreetMap) and commercial weather
# NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
# OPEN_METEO_API_KEY=""
