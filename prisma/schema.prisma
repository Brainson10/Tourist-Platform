generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TOURIST
  ADMIN
  GUIDE
  GOVERNMENT
}

enum TripStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ExperienceCategory {
  ADVENTURE
  CULTURE
  FOOD
  NATURE
  FESTIVAL
  WILDLIFE
  SPIRITUAL
}

model User {
  id           String       @id @default(cuid())
  fullName     String
  email        String       @unique
  passwordHash String
  avatar       String?
  role         UserRole     @default(TOURIST)
  phone        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  trips            Trip[]
  recommendations  Recommendation[]

  @@index([email])
  @@index([role])
}

model Destination {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  description        String
  shortDescription   String?
  fullDescription    String?
  state              String
  district           String
  latitude           Float
  longitude          Float
  coverImage         String?
  heroImage          String?
  galleryImages      String[] @default([])
  bestSeason         String?
  openingHours       String?
  estimatedDuration  String?
  entryFee           String?
  accessibility      String?
  safetyInfo         String?
  emergencyContacts  Json?
  tags               String[] @default([])
  categories         String[] @default([])
  history            String?
  culture            String?
  religion           String?
  traditions         String?
  language           String?
  food               String?
  thingsToDo         String[] @default([])
  nearbyAttractions  String[] @default([])
  transportation     String?
  hotels             Json?
  homestays          Json?
  hiddenGems         String[] @default([])
  isFeatured         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  experiences      Experience[]
  festivals        Festival[]
  stories          Story[]
  recommendations  Recommendation[]

  @@index([state])
  @@index([district])
  @@index([name])
  @@index([isFeatured])
}

model Experience {
  id             String              @id @default(cuid())
  destinationId  String
  title          String
  description    String
  category       ExperienceCategory
  difficulty     String
  duration       String
  price          Float
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  destination    Destination         @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@index([category])
  @@index([title])
}
model Festival {
  id             String             @id @default(cuid())
  destinationId  String
  title          String
  slug           String             @unique
  description    String
  imageUrl       String
  category       ExperienceCategory
  startDate      DateTime
  endDate        DateTime
  isFeatured     Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  destination    Destination        @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@index([startDate])
  @@index([category])
  @@index([isFeatured])
}

model Story {
  id             String   @id @default(cuid())
  destinationId  String
  title          String
  content        String
  language       String
  createdAt      DateTime @default(now())

  destination    Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@index([title])
}

model Trip {
  id        String     @id @default(cuid())
  userId    String
  title     String
  startDate DateTime
  endDate   DateTime
  status    TripStatus @default(PLANNING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Recommendation {
  id             String   @id @default(cuid())
  userId         String
  destinationId  String
  score          Int
  reason         String
  createdAt      DateTime @default(now())

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination    Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([destinationId])
  @@index([score])
}
