generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TOURIST
  GUIDE
  ADMIN
}

enum TripStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ExperienceCategory {
  ADVENTURE
  CULTURE
  FOOD
  NATURE
  FESTIVAL
  WILDLIFE
  SPIRITUAL
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum GuideStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SouvenirAudience {
  MYSELF
  FAMILY
  FRIENDS
  PARTNER
  CHILDREN
  PARENTS
  COLLECTORS
}

enum SouvenirInterest {
  CULTURE
  FOOD
  ART
  FASHION
  CRAFTS
  HOME_DECOR
  UNIQUE
}

enum SouvenirQuality {
  LOCALLY_MADE
  HANDMADE
  TRADITIONAL
  ARTISAN_MADE
  REGIONAL_SPECIALTY
}

enum SouvenirAvailability {
  YEAR_ROUND
  SEASONAL
  FESTIVAL_TIME
  LIMITED
}

enum SouvenirPhotoKind {
  PRODUCT
  MAKING
  MARKET
}

enum SellerKind {
  MARKET
  SHOP
  ARTISAN_WORKSHOP
  HANDICRAFT_CENTER
  COOPERATIVE
  OTHER
}

enum GuideRequestStatus {
  NEW
  ACCEPTED
  DECLINED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Accounts (Better Auth). `fullName` and `avatar` are mapped to Better Auth's
// `name` and `image` fields in lib/auth/config.js. Passwords live in Account.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  fullName      String
  email         String   @unique
  emailVerified Boolean  @default(false)
  avatar        String?
  role          UserRole @default(TOURIST)
  phone         String?
  isBlocked     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions          Session[]
  accounts          Account[]
  trips             Trip[]
  reviews           Review[]
  savedDestinations SavedDestination[]
  guideProfile      GuideProfile?
  guideRequests     GuideRequest[]

  @@index([role])
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Places. A destination's district and state always come from its village.
// ---------------------------------------------------------------------------

model Village {
  id          String   @id @default(cuid())
  name        String
  district    String
  state       String
  pincode     String?
  description String?
  latitude    Float
  longitude   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  destinations Destination[]
  sellers      LocalSeller[]

  @@unique([name, district])
  @@index([district])
  @@index([state])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  destinations DestinationCategory[]
}

model Destination {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  shortDescription  String
  description       String
  villageId         String
  latitude          Float
  longitude         Float
  coverImage        String?
  bestSeason        String?
  /// Months (1–12) that are the best time to visit; drives the calendar and "Best right now".
  bestMonths        Int[]    @default([])
  openingHours      String?
  estimatedDuration String?
  entryFee          String?
  accessibility     String?
  safetyInfo        String?
  /// [{ label, value, note? }]
  emergencyContacts Json?
  tags              String[] @default([])
  history           String?
  culture           String?
  religion          String?
  traditions        String?
  language          String?
  food              String?
  thingsToDo        String[] @default([])
  nearbyAttractions String[] @default([])
  transportation    String?
  /// [{ name, type?, contact?, address?, note? }]
  hotels            Json?
  /// [{ name, type?, contact?, address?, note? }]
  homestays         Json?
  hiddenGems        String[] @default([])
  isFeatured        Boolean  @default(false)
  /// Cached from APPROVED reviews by lib/services/review.service.js
  ratingAverage     Float    @default(0)
  reviewCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  village               Village               @relation(fields: [villageId], references: [id], onDelete: Restrict)
  photos                DestinationPhoto[]
  destinationCategories DestinationCategory[]
  experiences           Experience[]
  festivals             Festival[]
  stories               Story[]
  reviews               Review[]
  savedBy               SavedDestination[]
  trips                 Trip[]
  tripItems             TripItem[]
  guideAreas            GuideArea[]
  guideRequests         GuideRequest[]
  souvenirs             SouvenirDestination[]

  @@index([villageId])
  @@index([name])
  @@index([isFeatured])
  @@index([ratingAverage])
}

model DestinationCategory {
  destinationId String
  categoryId    String

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([destinationId, categoryId])
  @@index([categoryId])
}

model DestinationPhoto {
  id            String   @id @default(cuid())
  destinationId String
  imageUrl      String
  caption       String?
  isCover       Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, displayOrder])
}

model Review {
  id            String       @id @default(cuid())
  destinationId String
  userId        String
  rating        Int
  title         String?
  comment       String
  status        ReviewStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  destination Destination   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      ReviewPhoto[]

  @@unique([destinationId, userId])
  @@index([destinationId, status])
  @@index([userId])
  @@index([status])
}

model ReviewPhoto {
  id        String   @id @default(cuid())
  reviewId  String
  imageUrl  String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, position])
}

model SavedDestination {
  userId        String
  destinationId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([userId, destinationId])
  @@index([destinationId])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model Experience {
  id            String             @id @default(cuid())
  destinationId String
  title         String
  description   String
  category      ExperienceCategory
  difficulty    String?
  duration      String?
  /// Indicative price per person in INR. Null when unknown, 0 when free.
  price         Float?
  imageUrl      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  tripItems   TripItem[]

  @@index([destinationId])
  @@index([category])
  @@index([title])
}

model Festival {
  id            String             @id @default(cuid())
  destinationId String
  title         String
  slug          String             @unique
  description   String
  significance  String?
  imageUrl      String?
  category      ExperienceCategory @default(FESTIVAL)
  /// Null when the date has not been announced yet.
  startDate     DateTime?
  endDate       DateTime?
  isFeatured    Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@index([startDate])
  @@index([category])
  @@index([isFeatured])
}

model Story {
  id            String   @id @default(cuid())
  destinationId String
  title         String
  slug          String   @unique
  excerpt       String?
  content       String
  coverImage    String?
  authorName    String?
  language      String   @default("English")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Trip planning
// ---------------------------------------------------------------------------

model Trip {
  id            String     @id @default(cuid())
  userId        String
  destinationId String?
  title         String
  startDate     DateTime
  endDate       DateTime
  notes         String?
  status        TripStatus @default(PLANNING)
  travelers     Int        @default(1)
  /// Estimated spend per person per day in INR (stay, food, local transport).
  dailyBudget   Int?
  /// Set when the owner shares a read-only link; null means not shared.
  shareToken    String?    @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination?        @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  items       TripItem[]
  checklist   TripChecklistItem[]

  @@index([userId, startDate])
  @@index([status])
  @@index([destinationId])
}

model TripItem {
  id            String   @id @default(cuid())
  tripId        String
  /// 1-based day of the trip.
  day           Int
  position      Int      @default(0)
  title         String
  notes         String?
  time          String?
  destinationId String?
  experienceId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  experience  Experience?  @relation(fields: [experienceId], references: [id], onDelete: SetNull)

  @@index([tripId, day, position])
  @@index([destinationId])
  @@index([experienceId])
}

model TripChecklistItem {
  id        String   @id @default(cuid())
  tripId    String
  label     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
}

// ---------------------------------------------------------------------------
// Travel rules and local guides
// ---------------------------------------------------------------------------

/// Entry permit rules per state (e.g. Inner Line Permit). Keyed by the same state name as Village.state.
model StatePermit {
  id             String    @id @default(cuid())
  state          String    @unique
  required       Boolean   @default(false)
  permitName     String?
  whoNeedsIt     String?
  howToApply     String?
  applyUrl       String?
  fee            String?
  processingTime String?
  foreignersNote String?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model GuideProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  headline        String
  bio             String
  languages       String[]    @default([])
  yearsExperience Int         @default(0)
  /// Shared with a tourist only after the guide accepts their request.
  phone           String?
  photoUrl        String?
  status          GuideStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  areas    GuideArea[]
  requests GuideRequest[]

  @@index([status])
}

model GuideArea {
  guideId       String
  destinationId String

  guide       GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  destination Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([guideId, destinationId])
  @@index([destinationId])
}

model GuideRequest {
  id            String             @id @default(cuid())
  guideId       String
  touristId     String
  destinationId String?
  startDate     DateTime
  endDate       DateTime
  groupSize     Int                @default(1)
  message       String
  status        GuideRequestStatus @default(NEW)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  guide       GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  tourist     User         @relation(fields: [touristId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([guideId, status])
  @@index([touristId])
  @@index([destinationId])
}

// ---------------------------------------------------------------------------
// "Take Home a Memory": local souvenirs. Discovery only — no cart, checkout or orders.
// A souvenir's state comes from the destinations it is linked to; a seller's from its village.
// ---------------------------------------------------------------------------

/// Souvenir taxonomy (Handicrafts, Textiles, Food…). Separate from destination interest categories.
model SouvenirCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  souvenirs Souvenir[]
}

model Souvenir {
  id                String               @id @default(cuid())
  name              String
  slug              String               @unique
  shortDescription  String
  description       String
  /// Cultural or local significance: why it is special.
  whySpecial        String
  /// Practical reason to take it home (easy to carry, keeps well…).
  whyTakeHome       String
  authenticityTips  String?
  carryTips         String?
  categoryId        String
  /// Approximate price range in whole rupees. Null when unknown.
  priceMin          Int?
  priceMax          Int?
  currency          String               @default("INR")
  audiences         SouvenirAudience[]   @default([])
  interests         SouvenirInterest[]   @default([])
  qualities         SouvenirQuality[]    @default([])
  availability      SouvenirAvailability @default(YEAR_ROUND)
  availabilityNote  String?
  coverImage        String?
  isFeatured        Boolean              @default(false)
  isPublished       Boolean              @default(true)
  /// Set for sample or unconfirmed data until an admin checks it.
  needsVerification Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  category     SouvenirCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  destinations SouvenirDestination[]
  photos       SouvenirPhoto[]
  sellers      SouvenirSeller[]

  @@index([categoryId])
  @@index([isPublished, isFeatured])
}

model SouvenirDestination {
  souvenirId    String
  destinationId String

  souvenir    Souvenir    @relation(fields: [souvenirId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([souvenirId, destinationId])
  @@index([destinationId])
}

model SouvenirPhoto {
  id         String            @id @default(cuid())
  souvenirId String
  url        String
  caption    String?
  kind       SouvenirPhotoKind @default(PRODUCT)
  position   Int               @default(0)
  createdAt  DateTime          @default(now())

  souvenir Souvenir @relation(fields: [souvenirId], references: [id], onDelete: Cascade)

  @@index([souvenirId, position])
}

/// A place to buy souvenirs: a market, shop, artisan workshop or handicraft centre.
model LocalSeller {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  kind         SellerKind @default(MARKET)
  description  String?
  address      String?
  villageId    String?
  latitude     Float
  longitude    Float
  phone        String?
  website      String?
  openingHours String?
  isVerified   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  village   Village?         @relation(fields: [villageId], references: [id], onDelete: SetNull)
  souvenirs SouvenirSeller[]

  @@index([villageId])
}

model SouvenirSeller {
  souvenirId String
  sellerId   String
  /// e.g. "Ask for naturally dyed pieces".
  note       String?

  souvenir Souvenir    @relation(fields: [souvenirId], references: [id], onDelete: Cascade)
  seller   LocalSeller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([souvenirId, sellerId])
  @@index([sellerId])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
